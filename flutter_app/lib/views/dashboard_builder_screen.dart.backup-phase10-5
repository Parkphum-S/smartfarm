                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  // ============================================================
  // SYSTEM INFORMATION
  // ============================================================

  Widget _buildSystemInformation() {
    return Card(
      elevation: 1,
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment.start,
          children: [
            const Row(
              children: [
                Icon(Icons.dns),
                SizedBox(width: 10),
                Text(
                  'System Information',
                  style: TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
            const Divider(height: 24),
            _buildInfoRow(
              'Gateway',
              'Raspberry Pi 4',
            ),
            _buildInfoRow(
              'IP Address',
              '192.168.1.60',
            ),
            _buildInfoRow(
              'Database',
              'MariaDB',
            ),
            _buildInfoRow(
              'Communication',
              'MQTT',
            ),
            _buildInfoRow(
              'API',
              'PHP / Apache',
            ),
            _buildInfoRow(
              'SSE',
              _sseConnected
                  ? 'Connected'
                  : 'Disconnected',
            ),
            _buildInfoRow(
              'Connection',
              _sseConnected
                  ? 'Online'
                  : 'Offline',
            ),
